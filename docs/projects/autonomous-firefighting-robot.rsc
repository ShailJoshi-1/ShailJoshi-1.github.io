11:["$","section",null,{"className":"case-body shell","children":[["$","aside",null,{"children":[["$","div",null,{"className":"section-kicker","children":"Project anatomy"}],["$","p",null,{"children":"From problem definition through integration and validation."}]]}],["$","div",null,{"className":"case-copy","children":[["$","article",null,{"children":[["$","span",null,{"children":"01 / Context"}],["$","h2",null,{"children":"Overview"}],["$","p",null,{"children":"An autonomous robot built around an original chassis that integrates a servo drivetrain, thermal sensor array, water reservoir, and pump. Onboard processing uses heat-source information to navigate toward the highest-temperature zone and activate water suppression upon arrival."}]]}],["$","article",null,{"children":[["$","span",null,{"children":"02 / Goal"}],["$","h2",null,{"children":"Objective"}],["$","p",null,{"children":"Create a self-contained robot that detects a heat source, navigates toward it, and deploys water without relying on external computation."}]]}],["$","article",null,{"children":[["$","span",null,{"children":["03"," / Constraint"]}],["$","h2",null,{"children":"The challenge"}],["$","p",null,{"children":"Coordinate directional heat sensing, movement, and water suppression while packaging the drivetrain, sensors, reservoir, and pump into one autonomous platform."}]]}],["$","article",null,{"children":[["$","span",null,{"children":["04"," / Architecture"]}],["$","h2",null,{"children":"The solution"}],["$","p",null,{"children":"Designed and fabricated a custom chassis, integrated the sensing and water-delivery hardware, and implemented directional heat-source detection in embedded C. Real-time onboard sensor fusion supports navigation decisions and triggers the pump when the robot reaches the target zone."}]]}],["$","article",null,{"children":[["$","span",null,{"children":["05"," / Result"]}],["$","h2",null,{"children":"Outcome"}],["$","p",null,{"children":"Built an autonomous prototype that combines heat detection, onboard navigation, and water suppression in one platform. The accompanying photos and demonstration video document the physical build."}]]}]]}]]}]
